// Built-in demo scene, used when `loom run` gets no --scene (docs/architecture.md sections 10 and 11).
(
    version: 1,
    game: "souls",                    // 用哪个游戏跑这个场景
    camera: "main_cam",               // 当前相机节点的路径
    ambient: (0.2, 0.2, 0.25),        // 环境光，线性 RGB
    nodes: [
        (name: "ground", mesh: Plane, scale: (40.0, 1.0, 40.0), color: (0.35, 0.35, 0.38)),
        (name: "player", position: (0.0, 0.0, 0.0),
            mesh: Capsule(radius: 0.35, height: 1.8), color: (0.8, 0.25, 0.2),
            character: (run_speed: 4.0, turn_speed: 720.0),
            // Stamina, roll, sprint and backstep (docs/architecture.md section 11). Every value
            // here is the default: leaving a prop out gives the same game.
            props: [
                ("stamina_max", 100),            // stamina points
                ("stamina_regen", 45),           // stamina points per second
                ("stamina_delay_ticks", 30),     // ticks after using stamina before it comes back
                ("tap_ticks", 15),               // releasing roll within this many ticks is a tap
                ("sprint_speed", 6),             // meters per second
                ("sprint_cost", 15),             // stamina points per second
                ("roll_cost", 20),               // stamina points
                ("roll_ticks", 32),              // how long a roll lasts
                ("roll_distance", 3.2),          // meters
                ("roll_invuln_from", 1),         // invulnerable from this tick of the roll (1-based)
                ("roll_invuln_to", 20),          // ... to this one, inclusive
                ("backstep_cost", 12),           // stamina points
                ("backstep_ticks", 20),          // how long a backstep lasts
                ("backstep_distance", 1.5),      // meters
                ("backstep_invuln_from", 1),     // as for the roll
                ("backstep_invuln_to", 8),
                ("attack_cost", 15),             // light attack: stamina points
                ("attack_startup_ticks", 10),    // before the swing; can still turn
                ("attack_active_ticks", 4),      // the swing, sliding forward
                ("attack_recovery_ticks", 16),   // after the swing; the next action can be buffered
                ("attack_distance", 0.3),        // meters slid during the swing
                ("heavy_cost", 25),              // heavy attack: as for the light one
                ("heavy_startup_ticks", 22),
                ("heavy_active_ticks", 5),
                ("heavy_recovery_ticks", 23),
                ("heavy_distance", 0.6),
                ("attack_turn_speed", 180),      // degrees per second, during startup
                ("combo_max", 3),                // most light attacks in a row
                ("lock_range", 15),              // meters: targets this close can be locked on to
                ("lock_break_range", 20),        // meters: farther than this lets go of the target
                ("lock_angle", 60),              // degrees from where the camera looks
                ("lock_camera_speed", 360),      // degrees per second the camera follows the target
                ("lock_pitch_down", 15),         // degrees below the lock point the camera looks
                ("switch_threshold", 0.1),       // look_x (radians) flicked to switch targets
                ("switch_cooldown_ticks", 20),   // ticks after a switch before the next one
                ("attack_reach", 2),             // meters: radius of the light attack's sweep
                ("attack_arc", 120),             // degrees swept, right to left, centered on facing
                ("heavy_reach", 2.4),            // heavy attack: as for the light one
                ("heavy_arc", 90),
                ("swing_low", 0.3),              // meters above the feet: the band the swing sweeps
                ("swing_high", 1.6),
                ("attack_damage", 20),           // hp a light hit takes off
                ("heavy_damage", 35),
                ("attack_impact", 10),           // added up against the target's poise
                ("heavy_impact", 30),
                ("hp", 100),                     // the character's own health
                ("poise", 0),                    // 0: every hit with any impact staggers
                ("stagger_ticks", 30),           // how long a stagger lasts
                ("poise_reset_ticks", 60),       // ticks without a hit before impacts are forgotten
                ("respawn_ticks", 120),          // ticks lying dead before coming back at the start
                ("flask_charges", 3),            // drinks in a full flask
                ("flask_heal", 0.4),             // fraction of full health one drink gives back
                ("flask_ticks", 60),             // how long a drink takes
                ("flask_heal_tick", 30),         // the tick of a drink that heals
                ("flask_walk_speed", 1),         // m/s while drinking
                ("bloodstain_range", 1.5),       // meters: how close the character picks its souls back up
            ],
            children: [
                // 面朝方向的标记：胶囊体本身是旋转对称的，看不出朝向
                (name: "visor", position: (0.0, 1.5, -0.3), scale: (0.4, 0.15, 0.3),
                    mesh: Cube, color: (0.9, 0.85, 0.3)),
                // 原素瓶：只在喝的时候显示
                (name: "flask", position: (0.5, 1.2, -0.3), scale: (0.12, 0.25, 0.12),
                    mesh: Cube, color: (0.9, 0.7, 0.2)),
            ]),
        (name: "pillars", children: [
            (name: "a", position: (3.0, 1.5, -4.0), scale: (1.0, 3.0, 1.0), mesh: Cube, color: (0.6, 0.58, 0.52),
                collider: Box),
            (name: "b", position: (-3.0, 1.5, -4.0), scale: (1.0, 3.0, 1.0), mesh: Cube, color: (0.6, 0.58, 0.52),
                collider: Box),
            (name: "c", position: (0.0, 1.5, -9.0), scale: (1.0, 3.0, 1.0), mesh: Cube, color: (0.6, 0.58, 0.52),
                collider: Box),
        ]),
        (name: "wall", position: (-3.0, 1.0, 3.0), rotation: (0.0, 30.0, 0.0), scale: (4.0, 2.0, 0.5),
            mesh: Cube, color: (0.55, 0.5, 0.45), collider: Box),
        // Lock-on targets, locked on 1.2 m above the feet, and hurtboxes the
        // size of the body with 100 hp and poise 25 (the other health props
        // are the defaults). The body is only drawn; the block, not drawn,
        // is what the character bumps into; the hp bar shrinks with the hp.
        (name: "dummy_a", position: (-5.0, 0.0, -6.0),
            props: [("lock_height", 1.2), ("hurt_radius", 0.4), ("hurt_height", 1.8),
                ("hp", 100), ("poise", 25), ("souls", 50)],
            children: [
                (name: "body", mesh: Capsule(radius: 0.4, height: 1.8), color: (0.45, 0.5, 0.6)),
                (name: "block", position: (0.0, 0.9, 0.0), scale: (0.8, 1.8, 0.8), collider: Box),
                (name: "hp_bar", position: (0.0, 2.1, 0.0), scale: (0.8, 0.08, 0.08), mesh: Cube,
                    color: (0.8, 0.1, 0.1)),
            ]),
        (name: "dummy_b", position: (0.0, 0.0, -6.5),
            props: [("lock_height", 1.2), ("hurt_radius", 0.4), ("hurt_height", 1.8),
                ("hp", 100), ("poise", 25), ("souls", 50)],
            children: [
                (name: "body", mesh: Capsule(radius: 0.4, height: 1.8), color: (0.45, 0.5, 0.6)),
                (name: "block", position: (0.0, 0.9, 0.0), scale: (0.8, 1.8, 0.8), collider: Box),
                (name: "hp_bar", position: (0.0, 2.1, 0.0), scale: (0.8, 0.08, 0.08), mesh: Cube,
                    color: (0.8, 0.1, 0.1)),
            ]),
        (name: "dummy_c", position: (5.0, 0.0, -6.0),
            props: [("lock_height", 1.2), ("hurt_radius", 0.4), ("hurt_height", 1.8),
                ("hp", 100), ("poise", 25), ("souls", 50)],
            children: [
                (name: "body", mesh: Capsule(radius: 0.4, height: 1.8), color: (0.45, 0.5, 0.6)),
                (name: "block", position: (0.0, 0.9, 0.0), scale: (0.8, 1.8, 0.8), collider: Box),
                (name: "hp_bar", position: (0.0, 2.1, 0.0), scale: (0.8, 0.08, 0.08), mesh: Cube,
                    color: (0.8, 0.1, 0.1)),
            ]),
        // A stake that swings at the character, once a round of 120 ticks: 40 ticks of warning
        // (the arm out at the right end of the sector, orange), a 6-tick swing sweeping it right
        // to left, then the arm back on the center line. Like the dummies, it can be locked on to,
        // hit, staggered and killed, and stops swinging while staggered or dead.
        (name: "stake", position: (6.0, 0.0, 2.0),
            props: [
                ("lock_height", 1.0),            // meters above the feet: the lock point
                ("hurt_radius", 0.3),            // meters: the hurtbox around the post
                ("hurt_height", 1.6),            // meters, from the feet up
                ("hp", 100),                     // full health
                ("souls", 100),                  // what killing it gives the character
                ("poise", 25),                   // impacts added up past this stagger it
                ("swing_damage", 30),            // hp a hit takes off the character
                ("swing_impact", 20),            // added up against the character's poise
                ("swing_startup_ticks", 40),     // the warning before the swing
                ("swing_active_ticks", 6),       // the swing
                ("swing_recovery_ticks", 74),    // after the swing, until the next round
                ("swing_reach", 2.2),            // meters: radius of the swept sector
                ("swing_arc", 150),              // degrees swept, right to left, centered on -Z
                ("swing_low", 0.3),              // meters above the feet: the band the swing sweeps
                ("swing_high", 1.6),
            ],
            children: [
                (name: "post", position: (0.0, 0.8, 0.0), scale: (0.3, 1.6, 0.3), mesh: Cube,
                    color: (0.55, 0.4, 0.25)),
                (name: "block", position: (0.0, 0.8, 0.0), scale: (0.3, 1.6, 0.3), collider: Box),
                // On the center line; reaches from 0.2 m out to 2.2 m, the swing's reach.
                (name: "arm", position: (0.0, 1.1, -1.2), scale: (0.1, 0.1, 2.0), mesh: Cube,
                    color: (0.45, 0.33, 0.2)),
                (name: "hp_bar", position: (0.0, 1.9, 0.0), scale: (0.8, 0.08, 0.08), mesh: Cube,
                    color: (0.8, 0.1, 0.1)),
            ]),
        // A bonfire: sitting down at it (E) within 1.5 m gives full health and stamina, makes
        // the spot the respawn point and resets the world. The fire is only drawn; the block,
        // not drawn, is what the character bumps into.
        (name: "bonfire", position: (-6.0, 0.0, 6.0),
            props: [
                ("bonfire_range", 1.5),          // meters: how close the character sits down
            ],
            children: [
                (name: "fire", position: (0.0, 0.25, 0.0), scale: (0.5, 0.5, 0.5), mesh: Cube,
                    color: (1.0, 0.45, 0.1)),
                (name: "block", position: (0.0, 0.25, 0.0), scale: (0.5, 0.5, 0.5), collider: Box),
            ]),
        // Marks the bloodstain, where the character's souls dropped when it died; hidden
        // without one. Its position is the lift above the spot.
        (name: "bloodstain", position: (0.0, 0.05, 0.0), scale: (0.4, 0.1, 0.4), mesh: Cube,
            color: (0.3, 0.9, 0.5)),
        (name: "sun", position: (4.0, 8.0, 3.0), look_at: (0.0, 0.0, 0.0),
            light: (color: (1.0, 0.95, 0.9), intensity: 1.0)),
        (name: "main_cam", camera: (fov_y: 60.0, near: 0.1, far: 200.0),
            orbit_camera: (target: "player", pivot_height: 1.5, distance: 4.0,
                yaw: 0.0, pitch: -15.0, pitch_min: -70.0, pitch_max: 60.0,
                collision_radius: 0.2, return_speed: 4.0)),
    ],
)
