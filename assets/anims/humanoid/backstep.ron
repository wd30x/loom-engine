// Backstep: a short hop back, 20 ticks, as long as the default
// backstep_ticks (docs/architecture.md section 11, "模型和动画"). The
// node does not move; the game moves it back.
// Rotations are YXZ degrees about each bone's position along the model's
// axes (+X right, +Y up, -Z forward); see assets/anims/README.md for which
// way each bone turns.
//
// Tick 0: standing. 4: crouching to push off, the sword coming up on
// guard. 8: in the air, the body leaning back, the feet swinging
// forward. 12: landing on the balls of both feet, knees giving. 16:
// steadying. 20: standing, the sword on its way back down.
(
    length: 20,
    looping: false,
    bones: {
        // Down to push off, up in the air, down landing.
        "hips": (translation: [
            (0, (0.000, 0.000, 0.000)),
            (4, (0.000, -0.120, 0.000)),
            (8, (0.000, 0.040, 0.000)),
            (12, (0.000, -0.140, 0.000)),
            (16, (0.000, -0.080, 0.000)),
            (20, (0.000, -0.020, 0.000)),
        ]),
        // +X leans back in the air, -X crouches forward.
        "spine": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (4, (-8.0, 0.0, 0.0)),
            (8, (10.0, 0.0, 0.0)),
            (12, (4.0, 0.0, 0.0)),
            (16, (-2.0, 0.0, 0.0)),
            (20, (0.0, 0.0, 0.0)),
        ]),
        "chest": (rotation: [
