// Run left: sidesteps to the left, two steps a 30-tick loop, written
// for 4 m/s (RUN_CLIP_SPEED, docs/architecture.md section 11, "模型和
// 动画"): 1 m a step. For moving sideways while locked on: the body
// faces the target, on guard.
// Rotations are YXZ degrees about each bone's position along the model's
// axes (+X right, +Y up, -Z forward); see assets/anims/README.md for which
// way each bone turns.
//
// Each foot is on the ground 6 ticks of 15 (the left one from tick 0,
// the right one from 15), sweeping 0.4 m under its hip against the
// travel; the left foot steps 7 cm ahead of the other so
// the legs pass each other.
(
    length: 30,
    looping: true,
    bones: {
        // The legs. Stance keys are worked out so the ankle keeps still on the
        // ground while the body travels; swing keys lift the leg and bring it
        // round. +X lifts a thigh forward, Z opens it sideways (-Z the left one
        // out, +Z the right one), -X bends a knee, +X tips the toes up. The
        // right leg does what the left one did one step earlier.
        "upper_leg_l": (rotation: [
            (0, (18.5, 0.0, -14.7)),
            (2, (24.4, 0.0, -5.2)),
            (4, (25.1, 0.0, 5.2)),
            (6, (21.3, 0.0, 15.1)),
            (10, (30.0, 0.0, 6.1)),
            (15, (35.0, 0.0, -2.8)),
            (20, (30.0, 0.0, -10.2)),
            (25, (25.0, 0.0, -13.8)),
            (30, (18.5, 0.0, -14.7)),
        ]),
        "lower_leg_l": (rotation: [
            (0, (-26.3, 0.0, 0.0)),
            (2, (-38.9, 0.0, 0.0)),
            (4, (-40.2, 0.0, 0.0)),
            (6, (-31.6, 0.0, 0.0)),
            (10, (-60.0, 0.0, 0.0)),
            (15, (-70.0, 0.0, 0.0)),
            (20, (-55.0, 0.0, 0.0)),
            (25, (-35.0, 0.0, 0.0)),
            (30, (-26.3, 0.0, 0.0)),
        ]),
        "foot_l": (rotation: [
            (0, (8.3, -4.7, 13.3)),
            (2, (14.5, -2.2, 4.2)),
            (4, (15.2, 2.3, -4.1)),
            (6, (10.9, 5.5, -13.0)),
            (10, (20.0, 2.5, -5.1)),
            (15, (25.0, -0.6, 2.8)),
            (20, (20.0, -3.1, 9.4)),
            (25, (12.0, -4.4, 12.5)),
            (30, (8.3, -4.7, 13.3)),
        ]),
        "upper_leg_r": (rotation: [
            (0, (35.0, 0.0, -2.8)),
            (5, (30.0, 0.0, -10.2)),
            (10, (25.0, 0.0, -13.8)),
            (15, (8.3, 0.0, -14.7)),
            (17, (14.1, 0.0, -5.2)),
            (19, (14.8, 0.0, 5.2)),
            (21, (10.9, 0.0, 15.1)),
            (25, (30.0, 0.0, 6.1)),
            (30, (35.0, 0.0, -2.8)),
        ]),
        "lower_leg_r": (rotation: [
            (0, (-70.0, 0.0, 0.0)),
            (5, (-55.0, 0.0, 0.0)),
            (10, (-35.0, 0.0, 0.0)),
            (15, (-26.3, 0.0, 0.0)),
            (17, (-38.9, 0.0, 0.0)),
            (19, (-40.2, 0.0, 0.0)),
            (21, (-31.6, 0.0, 0.0)),
            (25, (-60.0, 0.0, 0.0)),
            (30, (-70.0, 0.0, 0.0)),
        ]),
        "foot_r": (rotation: [
            (0, (25.0, -0.1, 2.8)),
            (5, (20.0, -1.4, 9.7)),
            (10, (12.0, -2.0, 13.0)),
            (15, (18.3, -2.2, 13.9)),
            (17, (24.8, -1.4, 4.4)),
            (19, (25.5, 1.5, -4.4)),
            (21, (21.0, 3.0, -13.7)),
            (25, (20.0, 1.5, -5.4)),
            (30, (25.0, -0.1, 2.8)),
        ]),
        // The body bobs: 4 cm down landing, 5.5 cm at mid-stance, 1.5 cm in the air.
        "hips": (translation: [
            (0, (0.000, -0.040, 0.000)),
            (3, (0.000, -0.055, 0.000)),
            (6, (0.000, -0.040, 0.000)),
            (10, (0.000, -0.015, 0.000)),
            (15, (0.000, -0.040, 0.000)),
            (18, (0.000, -0.055, 0.000)),
            (21, (0.000, -0.040, 0.000)),
            (25, (0.000, -0.015, 0.000)),
            (30, (0.000, -0.040, 0.000)),
        ]),
        // Upright, leaning a little into the leftward travel.
        "spine": (rotation: [
            (0, (-3.0, 0.0, 0.0)),
            (30, (-3.0, 0.0, 0.0)),
        ]),
        "chest": (rotation: [
            (0, (0.0, 0.0, -3.0)),
            (30, (0.0, 0.0, -3.0)),
        ]),
        // On guard: the sword arm holds the blade up in front of the chest,
        // the left hand beside it (the same pose all loop).
        "upper_arm_l": (rotation: [
            (0, (19.8, -42.5, 41.8)),
            (30, (19.8, -42.5, 41.8)),
        ]),
        "lower_arm_l": (rotation: [
            (0, (83.7, 0.0, 0.0)),
            (30, (83.7, 0.0, 0.0)),
        ]),
        "upper_arm_r": (rotation: [
            (0, (9.6, 46.8, -27.0)),
            (30, (9.6, 46.8, -27.0)),
        ]),
        "lower_arm_r": (rotation: [
            (0, (87.6, 0.0, 0.0)),
            (30, (87.6, 0.0, 0.0)),
        ]),
        "weapon": (rotation: [
            (0, (25.7, 16.1, 13.9)),
            (30, (25.7, 16.1, 13.9)),
        ]),
    },
)
