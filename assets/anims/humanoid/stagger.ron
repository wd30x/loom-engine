// Stagger: knocked off balance, 30 ticks, the default stagger_ticks
// (docs/architecture.md section 11, "模型和动画"). The game also tips
// the node 20 degrees away from the hit, so the clip does not tip the
// whole body.
// Rotations are YXZ degrees about each bone's position along the model's
// axes (+X right, +Y up, -Z forward); see assets/anims/README.md for which
// way each bone turns.
//
// Tick 0: standing. 3: struck, the upper body thrown back, the arms
// flung out. 8: stumbling half a step back onto the right foot, knees
// giving. 15: catching itself. 22: back on guard, the feet where they
// stumbled to. 30: steady on guard.
(
    length: 30,
    looping: false,
    bones: {
        // Knees giving: the body sinks, then comes back up.
        "hips": (translation: [
            (0, (0.000, 0.000, 0.000)),
            (3, (0.000, -0.030, 0.000)),
            (8, (0.000, -0.100, 0.000)),
            (15, (0.000, -0.120, 0.000)),
            (22, (0.000, -0.060, 0.000)),
            (30, (0.000, -0.040, 0.000)),
        ]),
        // +X throws the upper body back; the chest twists with the hit.
        "spine": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (3, (14.0, 0.0, 0.0)),
            (8, (10.0, 0.0, 0.0)),
            (15, (-4.0, 0.0, 0.0)),
            (22, (0.0, 0.0, 0.0)),
            (30, (0.0, 0.0, 0.0)),
        ]),
        "chest": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (3, (12.0, 8.0, 0.0)),
            (8, (8.0, 5.0, 0.0)),
            (15, (-2.0, 0.0, 0.0)),
            (22, (0.0, 0.0, 0.0)),
            (30, (0.0, 0.0, 0.0)),
        ]),
        "head": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (3, (15.0, -8.0, 0.0)),
            (8, (8.0, -5.0, 0.0)),
            (15, (2.0, 0.0, 0.0)),
            (22, (0.0, 0.0, 0.0)),
            (30, (0.0, 0.0, 0.0)),
        ]),
        // Arms flung out, then back to guard (the sword up in front).
        "upper_arm_l": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (3, (-20.0, 0.0, -25.0)),
            (8, (-10.0, 0.0, -15.0)),
            (15, (9.9, -21.2, 20.9)),
