            (3, (-15.0, 0.0, 30.0)),
            (8, (-5.0, 0.0, 15.0)),
            (15, (4.8, 23.4, -13.5)),
            (22, (9.6, 46.8, -27.0)),
            (30, (9.6, 46.8, -27.0)),
        ]),
