// Sprint: two steps a 36-tick loop, written for 6 m/s (SPRINT_CLIP_SPEED,
// docs/architecture.md section 11, "模型和动画"): 1.8 m a step. Like the
// run, with a longer stride, a deeper lean and bigger arm swings; the
// sword trails low behind the hand.
// Rotations are YXZ degrees about each bone's position along the model's
// axes (+X right, +Y up, -Z forward); see assets/anims/README.md for which
// way each bone turns.
//
// Each foot is on the ground 6 ticks of 18: the left one from tick 0
// (0.3 m ahead of its hip) to 6 (0.3 m behind), the right one from 18
// to 24. The body leans 20 degrees forward.
(
    length: 36,
    looping: true,
    bones: {
        // The legs. Stance keys are worked out so the ankle keeps still on the
        // ground while the body travels; swing keys lift the leg and bring it
        // round. +X lifts a thigh forward, Z opens it sideways (-Z the left one
        // out, +Z the right one), -X bends a knee, +X tips the toes up. The
        // right leg does what the left one did one step earlier.
        "upper_leg_l": (rotation: [
            (0, (31.5, 0.0, 0.0)),
            (2, (30.4, 0.0, 0.0)),
            (4, (16.9, 0.0, 0.0)),
            (6, (-4.5, 0.0, 0.0)),
            (10, (-15.0, 0.0, 0.0)),
            (14, (0.0, 0.0, 0.0)),
            (18, (25.0, 0.0, 0.0)),
            (24, (52.0, 0.0, 0.0)),
            (29, (56.0, 0.0, 0.0)),
            (33, (43.0, 0.0, 0.0)),
            (36, (31.5, 0.0, 0.0)),
        ]),
        "lower_leg_l": (rotation: [
            (0, (-20.3, 0.0, 0.0)),
            (2, (-46.3, 0.0, 0.0)),
            (4, (-49.6, 0.0, 0.0)),
            (6, (-36.1, 0.0, 0.0)),
            (10, (-85.0, 0.0, 0.0)),
            (14, (-120.0, 0.0, 0.0)),
            (18, (-125.0, 0.0, 0.0)),
            (24, (-90.0, 0.0, 0.0)),
            (29, (-45.0, 0.0, 0.0)),
            (33, (-22.0, 0.0, 0.0)),
            (36, (-20.3, 0.0, 0.0)),
        ]),
        "foot_l": (rotation: [
            (0, (-6.3, 0.0, 0.0)),
            (2, (15.9, 0.0, 0.0)),
            (4, (24.8, 0.0, 0.0)),
            (6, (15.6, 0.0, 0.0)),
            (10, (10.0, 0.0, 0.0)),
            (14, (20.0, 0.0, 0.0)),
            (18, (25.0, 0.0, 0.0)),
            (24, (20.0, 0.0, 0.0)),
            (29, (10.0, 0.0, 0.0)),
            (33, (0.0, 0.0, 0.0)),
            (36, (-6.3, 0.0, 0.0)),
        ]),
        "upper_leg_r": (rotation: [
            (0, (25.0, 0.0, 0.0)),
            (6, (52.0, 0.0, 0.0)),
            (11, (56.0, 0.0, 0.0)),
            (15, (43.0, 0.0, 0.0)),
            (18, (31.5, 0.0, 0.0)),
            (20, (30.4, 0.0, 0.0)),
            (22, (16.9, 0.0, 0.0)),
            (24, (-4.5, 0.0, 0.0)),
            (28, (-15.0, 0.0, 0.0)),
            (32, (0.0, 0.0, 0.0)),
            (36, (25.0, 0.0, 0.0)),
        ]),
        "lower_leg_r": (rotation: [
            (0, (-125.0, 0.0, 0.0)),
            (6, (-90.0, 0.0, 0.0)),
            (11, (-45.0, 0.0, 0.0)),
            (15, (-22.0, 0.0, 0.0)),
            (18, (-20.3, 0.0, 0.0)),
            (20, (-46.3, 0.0, 0.0)),
            (22, (-49.6, 0.0, 0.0)),
            (24, (-36.1, 0.0, 0.0)),
            (28, (-85.0, 0.0, 0.0)),
            (32, (-120.0, 0.0, 0.0)),
            (36, (-125.0, 0.0, 0.0)),
        ]),
        "foot_r": (rotation: [
            (0, (25.0, 0.0, 0.0)),
            (6, (20.0, 0.0, 0.0)),
            (11, (10.0, 0.0, 0.0)),
            (15, (0.0, 0.0, 0.0)),
            (18, (-6.3, 0.0, 0.0)),
            (20, (15.9, 0.0, 0.0)),
            (22, (24.8, 0.0, 0.0)),
            (24, (15.6, 0.0, 0.0)),
            (28, (10.0, 0.0, 0.0)),
            (32, (20.0, 0.0, 0.0)),
            (36, (25.0, 0.0, 0.0)),
        ]),
        // The body bobs: 6 cm down landing, 7.5 cm at mid-stance, 1 cm in the air.
        "hips": (translation: [
            (0, (0.000, -0.060, 0.000)),
            (3, (0.000, -0.075, 0.000)),
            (6, (0.000, -0.060, 0.000)),
            (12, (0.000, -0.010, 0.000)),
            (18, (0.000, -0.060, 0.000)),
            (21, (0.000, -0.075, 0.000)),
            (24, (0.000, -0.060, 0.000)),
            (30, (0.000, -0.010, 0.000)),
            (36, (0.000, -0.060, 0.000)),
        ]),
        // Leaning forward 20 degrees, the chest turning with the arms, the head
        // up so it looks ahead.
        "spine": (rotation: [
            (0, (-10.0, 0.0, 0.0)),
            (36, (-10.0, 0.0, 0.0)),
        ]),
        "chest": (rotation: [
            (0, (-10.0, 7.0, 0.0)),
            (18, (-10.0, -7.0, 0.0)),
            (36, (-10.0, 7.0, 0.0)),
        ]),
        "head": (rotation: [
            (0, (18.0, -7.0, 0.0)),
            (18, (18.0, 7.0, 0.0)),
            (36, (18.0, -7.0, 0.0)),
        ]),
        // Arms: +X swings forward, -X back; +Z brings the left arm in to
        // the body, -Z the right one; the elbows bend forward (+X).
        "upper_arm_l": (rotation: [
            (0, (-50.0, 0.0, 25.0)),
            (18, (50.0, 0.0, 25.0)),
            (36, (-50.0, 0.0, 25.0)),
        ]),
        "lower_arm_l": (rotation: [
            (0, (85.0, 0.0, 0.0)),
            (18, (100.0, 0.0, 0.0)),
            (36, (85.0, 0.0, 0.0)),
        ]),
        "upper_arm_r": (rotation: [
            (0, (15.0, 0.0, -20.0)),
            (18, (-35.0, 0.0, -20.0)),
            (36, (15.0, 0.0, -20.0)),
        ]),
        "lower_arm_r": (rotation: [
            (0, (50.0, 0.0, 0.0)),
            (36, (50.0, 0.0, 0.0)),
        ]),
        // The blade tipped 10 degrees down, trailing.
        "weapon": (rotation: [
            (0, (-10.0, 0.0, 0.0)),
            (36, (-10.0, 0.0, 0.0)),
        ]),
    },
)
