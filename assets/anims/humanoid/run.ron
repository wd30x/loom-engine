        ]),
        "foot_r": (rotation: [
            (0, (25.0, 0.0, 0.0)),
            (6, (20.0, 0.0, 0.0)),
            (12, (10.0, 0.0, 0.0)),
            (16, (0.0, 0.0, 0.0)),
            (20, (-3.8, 0.0, 0.0)),
            (22, (9.6, 0.0, 0.0)),
            (24, (22.2, 0.0, 0.0)),
