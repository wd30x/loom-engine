            (34, (0.000, -0.010, 0.000)),
            (40, (0.000, -0.045, 0.000)),
        ]),
        // Leaning forward: -X on spine and chest; the chest turns with the
        // arms (+Y is to the left), the head against both so it looks ahead.
        "spine": (rotation: [
            (0, (-6.0, 0.0, 0.0)),
            (40, (-6.0, 0.0, 0.0)),
        ]),
        "chest": (rotation: [
            (0, (-6.0, 5.0, 0.0)),
            (20, (-6.0, -5.0, 0.0)),
            (40, (-6.0, 5.0, 0.0)),
        ]),
        "head": (rotation: [
            (0, (10.0, -5.0, 0.0)),
            (20, (10.0, 5.0, 0.0)),
            (40, (10.0, -5.0, 0.0)),
        ]),
        // Arms: +X swings forward, -X back; +Z brings the left arm in to
        // the body, -Z the right one; the elbows bend forward (+X).
        "upper_arm_l": (rotation: [
            (0, (-35.0, 0.0, 25.0)),
            (20, (35.0, 0.0, 25.0)),
            (40, (-35.0, 0.0, 25.0)),
        ]),
        "lower_arm_l": (rotation: [
            (0, (70.0, 0.0, 0.0)),
