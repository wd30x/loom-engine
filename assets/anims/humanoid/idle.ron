// Idle: standing and breathing, a 2 s loop (docs/architecture.md section 19).
// Rotations are YXZ degrees about each bone's position along the model's
// axes (+X right, +Y up, -Z forward); see assets/anims/README.md for which
// way each bone turns. Every channel starts and ends on the same value, so
// the loop has no seam.
(
    length: 120,
    looping: true,
    bones: {
        // Breathing in (to tick 60) lifts and opens the chest a little: it
        // tips back 2 degrees, then settles.
        "chest": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (60, (2.0, 0.0, 0.0)),
            (120, (0.0, 0.0, 0.0)),
        ]),
        // The body sinks 6 mm as the breath goes out, back up as it comes in.
        "hips": (translation: [
            (0, (0.0, -0.006, 0.0)),
            (60, (0.0, 0.0, 0.0)),
            (120, (0.0, -0.006, 0.0)),
        ]),
        // The head counters the chest so the gaze stays level.
        "head": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (60, (-1.5, 0.0, 0.0)),
            (120, (0.0, 0.0, 0.0)),
        ]),
        // The arms drift in toward the body and a little forward on the
        // breath: +Z brings the left arm in, -Z the right one.
        "upper_arm_l": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (60, (2.0, 0.0, 3.0)),
            (120, (0.0, 0.0, 0.0)),
        ]),
        // The sword arm moves less; the blade tip stays well above the
        // ground (about 0.3 m at its lowest).
        "upper_arm_r": (rotation: [
            (0, (0.0, 0.0, 0.0)),
            (60, (1.0, 0.0, -2.0)),
            (120, (0.0, 0.0, 0.0)),
        ]),
    },
)
