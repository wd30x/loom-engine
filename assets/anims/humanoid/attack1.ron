        ]),
        // The body turns with the swing: -Y to the right winding up, +Y to
        // the left following through, leaning into the cut (-X); the head
        // turns less, the other way, to keep looking ahead.
        "spine": (rotation: [
            (0, (0.0, 0.0, 0.0)),
