// Preview of the E4.1 tiles, rendered without a game:
//   loom view --scene assets/scenes/tiles_preview.ron --screenshot out/view.png
// (docs/architecture.md section 14).
// Pixel alignment: at the default 1280x720 and ortho height 11.25, one world unit (one cell) is
// 720 / 11.25 = 64 pixels, so the 16-pixel tiles are scaled exactly 4x. The view is
// 11.25 * 1280 / 720 = 20 cells wide. With the camera at x = 9.5 its left edge is 9.5 - 10 = -0.5,
// the left side of column 0; at y = -5.125 its top edge is -5.125 + 5.625 = 0.5, the top of row 0.
// So row r, column c covers [64c, 64c + 64) x [64r, 64r + 64) of the screenshot. The view is 11.25
// cells tall: only the top 16 pixels of the last row (11) show.
(
    version: 1,
    camera: "cam",
    ambient: (1.0, 1.0, 1.0),         // sprites are unlit: any value will do
    nodes: [
        (name: "cam", position: (9.5, -5.125, 10.0),
            camera: (ortho: (height: 11.25), near: 0.1, far: 100.0)),
        // 20 columns, 12 rows, at the origin: row r, column c is centered at (c, -r, 0)
        (name: "map", tilemap: (
            sheet: "assets/art/tiles.json",
            legend: [('#', "wall"), ('.', "floor")],
            rows: [
                "####################",
                "#..................#",
                "#..................#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#######....#",
                "#..................#",
                "#..................#",
                "####################",
            ],
        )),
        // z = 1: in front of the map
        (name: "player", position: (3.0, -2.0, 1.0),
            sprite: (sheet: "assets/art/tiles.json", tag: "player")),
        (name: "zombie", position: (12.0, -7.0, 1.0),
            sprite: (sheet: "assets/art/tiles.json", tag: "zombie")),
    ],
)
