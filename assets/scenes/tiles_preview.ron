// E4.1 瓦片的预览场景，用 `loom view --scene assets/scenes/tiles_preview.ron --screenshot out/view.png` 看（docs/architecture.md 第 14 节）。
// 像素对齐：默认 1280x720，ortho height 11.25，所以每个世界单位（一格）是 720 / 11.25 = 64 像素，16 像素的瓦片正好放大 4 倍；
// 画面宽 11.25 * 1280 / 720 = 20 格。相机 x = 9.5，左边缘是 9.5 - 10 = -0.5，就是第 0 列的左边；
// 相机 y = -5.125，上边缘是 -5.125 + 5.625 = 0.5，就是第 0 行的上边。所以第 r 行第 c 列占截图的
// [64c, 64c + 64) x [64r, 64r + 64)。画面高 11.25 格，最下面第 11 行只露出上面 16 像素。
(
    version: 1,
    camera: "cam",
    ambient: (1.0, 1.0, 1.0),         // 精灵不受光照影响，这里随便写
    nodes: [
        (name: "cam", position: (9.5, -5.125, 10.0),
            camera: (ortho: (height: 11.25), near: 0.1, far: 100.0)),
        // 20 列 12 行，节点在原点：第 r 行第 c 列的中心在 (c, -r, 0)
        (name: "map", tilemap: (
            sheet: "assets/art/tiles.json",
            legend: [('#', "wall"), ('.', "floor")],
            rows: [
                "####################",
                "#..................#",
                "#..................#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#..........#",
                "#.......#######....#",
                "#..................#",
                "#..................#",
                "####################",
            ],
        )),
        // z = 1，在地面前面
        (name: "player", position: (3.0, -2.0, 1.0),
            sprite: (sheet: "assets/art/tiles.json", tag: "player")),
        (name: "zombie", position: (12.0, -7.0, 1.0),
            sprite: (sheet: "assets/art/tiles.json", tag: "zombie")),
    ],
)
